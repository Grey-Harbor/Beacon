{
  "name": "@greyharbor/beacon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npm run build -w @beacon/shared && npm run check -w @beacon/server && npm run check -w @beacon/web",
    "dev": "npm run dev -w @beacon/server",
    "dev:web": "npm run dev -w @beacon/web",
    "docs:check": "node scripts/check-docs.mjs",
    "secrets:generate": "sh scripts/generate-beacon-secrets.sh",
    "site:check": "npm --prefix site run check",
    "site:build": "npm --prefix site run build",
    "site:preview": "npm --prefix site run preview",
    "preview": "npm --prefix site run preview",
    "start": "npm run start -w @beacon/server",
    "test": "npm run build -w @beacon/shared && node --test scripts/*.test.mjs && npm run test -w @beacon/server && npm run test -w @beacon/web",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "ci": "npm run format:check && npm run docs:check && npm run check && npm test && npm run build"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
